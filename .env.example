# Пример окружения. Скопируй в .env и вставь свой ключ:
#   cp .env.example .env
#
# .env НЕ коммитится (см. .gitignore). Ключ читается python-dotenv
# при запуске main.py и/или как обычная переменная окружения.

# Ключ DeepSeek: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Необязательно: альтернативный базовый URL API
# DEEPSEEK_API_BASE=https://api.deepseek.com
